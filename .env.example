# OpenAI-compatible API (своя модель)
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://your-llm-host.example/v1
OPENAI_MODEL=your-model-name

# Опционально
OPENAI_TIMEOUT_SECONDS=120
MOEX_TIMEOUT_SECONDS=30
